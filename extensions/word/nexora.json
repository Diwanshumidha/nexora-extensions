{
  "id": "word",
  "name": "Word",
  "version": "0.1.0",
  "protocol": 1,
  "description": "Create Word documents (.docx)",
  "icon": "document",
  "namespace": "word",
  "runtime": "node",
  "main": "dist/index.js",
